{
  "expo": {
    "name": "Sagana Rider",
    "slug": "sagana-rider",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/branding/rider-app-icon.png",
    "scheme": "saganarider",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sagana.rider",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Sagana Rider uses your location to navigate to farmer pickups and buyer deliveries.",
        "NSCameraUsageDescription": "Sagana Rider uses the camera to take proof-of-pickup and delivery photos.",
        "NSMicrophoneUsageDescription": "Sagana Rider uses the microphone for in-app calls with farmers and buyers during a delivery."
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#D7ECC1",
      "barStyle": "dark-content",
      "translucent": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/rider-app-icon-adaptive.png",
        "backgroundColor": "#087434"
      },
      "package": "com.sagana.rider",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/branding/official_sagana_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/sagana-wordform-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#D7ECC1"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-image-picker",
      "expo-secure-store",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#087434"
        }
      ],
      "./plugins/withGoogleMapsKey",
      "./plugins/withGoogleServicesFile"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0ec50dcf-4f23-40ea-8e82-7da5dba1808a"
      },
      "router": {},
      "googleMapsApiKey": ""
    },
    "owner": "sagana_ph"
  }
}
